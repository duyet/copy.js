{
  "name": "copy-js",
  "version": "0.2.0",
  "description": "Elegant clipboard copy for the modern web. Zero dependencies, TypeScript support, Promise-based with intelligent fallbacks.",
  "type": "module",
  "main": "./dist/cjs/copy.js",
  "module": "./dist/esm/copy.js",
  "types": "./dist/esm/copy.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/copy.d.ts",
        "default": "./dist/esm/copy.js"
      },
      "require": {
        "types": "./dist/cjs/copy.d.ts",
        "default": "./dist/cjs/copy.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose --coverage",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:umd",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/fix-cjs.js",
    "build:umd": "node scripts/build-umd.js",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "prepublishOnly": "npm run test && npm run build",
    "prepare": "npm run build",
    "demo": "npx serve examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyetdev/copy.js.git"
  },
  "keywords": [
    "copy",
    "clipboard",
    "copy-to-clipboard",
    "clipboard-api",
    "typescript",
    "modern",
    "async",
    "promise",
    "zero-dependencies",
    "lightweight",
    "copy.js",
    "browser",
    "dom",
    "navigator.clipboard",
    "execCommand",
    "esm",
    "cjs",
    "umd",
    "tree-shakeable",
    "elegant",
    "fallback"
  ],
  "author": {
    "name": "Van-Duyet Le",
    "email": "me@duyetdev.com",
    "url": "https://github.com/duyetdev"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/duyetdev/copy.js/issues"
  },
  "homepage": "https://github.com/duyetdev/copy.js#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/duyetdev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.27.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
